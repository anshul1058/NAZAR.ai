# Auto-detect text files & normalize line endings ke LF
* text=auto eol=lf

# Force LF untuk source code
*.dart   text eol=lf
*.kt     text eol=lf
*.java   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.gradle text eol=lf
*.xml    text eol=lf

# Force CRLF untuk Windows-only files
*.bat    text eol=crlf
*.cmd    text eol=crlf

# Binary files — jangan di-diff
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
*.apk    binary
*.aab    binary
*.keystore binary
*.jks    binary
