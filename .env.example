# PERISAI environment config
#
# Cara pakai:
# 1. Copy file ini jadi `.env` (di root project, gitignored)
# 2. Isi nilai sebenarnya dari Supabase Dashboard → Settings → API
# 3. Jalankan `flutter run` — app akan baca dari .env
#
# Di CI, `.env` di-generate dari GitHub Actions Secrets.

# ─── Supabase (WAJIB) ─────────────────────────────────
# URL project Supabase kamu
SUPABASE_URL=https://your-project.supabase.co

# Anon (public) key — bukan service_role!
SUPABASE_ANON_KEY=your-anon-key-here

# ─── Environment flag ────────────────────────────────
# dev | staging | prod
APP_ENV=dev
